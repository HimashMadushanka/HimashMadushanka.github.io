    "skills": "\n        <h2 class=\"section-title\">Technical <span>Skills</span></h2>\n        <p class=\"skills-intro\">A practical toolkit for turning data into clear insights and data-driven solutions.</p>\n        <div class=\"skills-grid\">\n            <div class=\"skill-card\"><i class=\"fab fa-python\" aria-hidden=\"true\"></i><span>Python</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-database\" aria-hidden=\"true\"></i><span>SQL</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-file-excel\" aria-hidden=\"true\"></i><span>Microsoft Excel</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-chart-column\" aria-hidden=\"true\"></i><span>Power BI</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-chart-pie\" aria-hidden=\"true\"></i><span>Tableau</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-table\" aria-hidden=\"true\"></i><span>Pandas</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-calculator\" aria-hidden=\"true\"></i><span>NumPy</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-gears\" aria-hidden=\"true\"></i><span>Scikit-learn</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-brain\" aria-hidden=\"true\"></i><span>PyTorch</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-network-wired\" aria-hidden=\"true\"></i><span>TensorFlow</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-lightbulb\" aria-hidden=\"true\"></i><span>SHAP</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-comments\" aria-hidden=\"true\"></i><span>NLP</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-database\" aria-hidden=\"true\"></i><span>MySQL</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-leaf\" aria-hidden=\"true\"></i><span>MongoDB</span></div>\n            <div class=\"skill-card\"><i class=\"fas fa-server\" aria-h