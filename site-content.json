    "certifications": "\n        <h2 class=\"section-title\">My <span>Certifications</span></h2>\n        <div class=\"certifications-grid\">\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Python for Beginners E-Certificate</h3>\n                    <p class=\"certification-provider\">University of Moratuwa (UOM)</p>\n                    <p class=\"certification-description\">Covers Python fundamentals, including variables, data types, conditions, loops, and basic programming.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Python Bootcamp</h3>\n                    <p class=\"certification-provider\">Udemy</p>\n                    <p class=\"certification-description\">Builds practical Python skills through coding exercises and small programming tasks.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Introduction to Tableau</h3>\n                    <p class=\"certification-provider\">Simplilearn</p>\n                    <p class=\"certification-description\">Introduces creating charts and interactive visualizations to explore and present data.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Power BI Data Modeling with DAX</h3>\n                    <p class=\"certification-provider\">LinkedIn Learning</p>\n                    <p class=\"certification-description\">Covers organizing data models and using DAX to create calculations and measures in Power BI.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Dashboards for Beginners</h3>\n                    <p class=\"certification-provider\">Simplilearn</p>\n                    <p class=\"certification-description\">Introduces dashboard basics, including presenting key information with clear visual summaries.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>Data Cleaning and Manipulating with Python in Excel</h3>\n                    <p class=\"certification-provider\">LinkedIn Learning</p>\n                    <p class=\"certification-description\">Explores using Python in Excel to clean, transform, and analyze spreadsheet data.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>The Git &amp; GitHub Bootcamp</h3>\n                    <p class=\"certification-provider\">Udemy</p>\n                    <p class=\"certification-description\">Covers version control with Git and collaborating on projects using GitHub.</p>\n                </div>\n            </article>\n            <article class=\"certification-card\">\n                <i class=\"fas fa-certificate\" aria-hidden=\"true\"></i>\n                <div>\n                    <h3>The Complete Full-Stack Web Development Bootcamp</h3>\n                    <p class=\"certification-provider\">Udemy · Certificate of Completion</p>\n                    <p class=\"certification-description\">Learned how to build full-stack websites, including front-end interfaces and back-end functionality.</p>\n                </div>\n            </article>\n        </div>\n    ",
    "achievements": "\n        <h2 class=\"section-title\">My <span>Achievements</span></h2>\n        <div class=\"achievements-grid\">\n            <article class=\"achievement-card\">\n                <button class=\"achievement-preview\" type=\"button\" aria-label=\"Enlarge certificate: The Business Analysis Experience Program\">\n                    <img src=\"image/achievements/business-analysis.jpg\" alt=\"Certificate of participation in The Business Analysis Experience Program\" loading=\"lazy\" decoding=\"async\">\n                    <span class=\"preview-hint\"><i class=\"fas fa-magnifying-glass-plus\" aria-hidden=\"true\"></i> Click to enlarge</span>\n                </button>\n                <div class=\"achievement-info\">\n                    <h3>The Business Analysis Experience Program</h3>\n                    <p>Participated in a business analysis experience program organized by IEEE Young Professionals Sri Lanka and IEEE Lets Talk.</p>\n                    <p class=\"achievement-meta\">October 11, 2025 · Informatics Institute of Technology, Colombo</p>\n                </div>\n            </article>\n            <article class=\"achievement-card\">\n                <button class=\"achievement-preview\" type=\"button\" aria-label=\"Enlarge certificate: Data Xplore 2.0 and Online Dashboard Workshop\">\n                    <img src=\"image/achievements/data-xplore.jpg\" alt=\"Certificate of participation in Data Xplore 2.0 and its Online Dashboard Workshop\" loading=\"lazy\" decoding=\"async\">\n                    <span class=\"preview-hint\"><i class=\"fas fa-magnifying-glass-plus\" aria-hidden=\"true\"></i> Click to enlarge</span>\n                </button>\n                <div class=\"achievement-info\">\n                    <h3>Data Xplore 2.0 &amp; Online Dashboard Workshop</h3>\n                    <p>Participated in data analysis and report submission for Data Xplore 2.0, along with an online dashboard workshop.</p>\n                    <p class=\"achievement-meta\">April 25, 2026 · Statistics Society, University of Sri Jayewardenepura</p>\n                </div>\n            </article>\n            <article class=\"achievement-card\">\n                <button class=\"achievement-preview\" type=\"button\" aria-label=\"Enlarge certificate: Engineering for Humanity 2026 Webinar\">\n                    <img src=\"image/achievements/engineering-humanity.jpg\" alt=\"Certificate of participation in the Engineering for Humanity 2026 pre-conference webinar\" loading=\"lazy\" decoding=\"async\">\n                    <span class=\"preview-hint\"><i class=\"fas fa-magnifying-glass-plus\" aria-hidden=\"true\"></i> Click to enlarge</span>\n                </button>\n                <div class=\"achievement-info\">\n                    <h3>Engineering for Humanity 2026 Webinar</h3>\n                    <p>Attended a pre-conference webinar on AI-enabled energy infrastructure, exploring systems-level approaches to stronger, greener energy.</p>\n                    <p class=\"achievement-meta\">April 28, 2026 · Engineers Without Borders Sri Lanka and gapHQ</p>\n                </div>\n            </article>\n            <article class=\"achievement-card\">\n                <button class=\"achievement-preview\" type=\"button\" aria-label=\"Enlarge certificate: IEEE Digital Vesak Art Competition 2026\">\n                    <img src=\"image/achievements/ieee-vesak-art-competition.jpg\" alt=\"Certificate of participation in the IEEE Digital Vesak Art Competition 2026\" loading=\"lazy\" decoding=\"async\">\n                    <span class=\"preview-hint\"><i class=\"fas fa-magnifying-glass-plus\" aria-hidden=\"true\"></i> Click to enlarge</span>\n                </button>\n                <div class=\"achievement-info\">\n                    <h3>IEEE Digital Vesak Art Competition 2026</h3>\n                    <p>Participated in a digital art competition celebrating Vesak through creative artwork.</p>\n                    <p class=\"achievement-meta\">IEEE Student Branch · Sabaragamuwa University of Sri Lanka</p>\n                </div>\n            </article>\n            <article class=\"achievement-card\">\n                <button class=\"achievement-preview\" type=\"button\" aria-label=\"Enlarge certificate: ArtistryX AI Digital Art Competition 2026\">\n                    <img src=\"image/achievements/artistryx-ai-art-competition.jpg\" alt=\"Certificate of participation in the ArtistryX AI Digital Art Competition 2026\" loading=\"lazy\" decoding=\"async\">\n                    <span class=\"preview-hint\"><i class=\"fas fa-magnifying-glass-plus\" aria-hidden=\"true\"></i> Click to enlarge</span>\n                </button>\n                <div class=\"achievement-info\">\n                    <h3>ArtistryX — AI Digital Art Competition 2026</h3>\n                    <p>Created AI-assisted digital art for “Sri Lanka 2050: Tradition Meets the Future,” exploring creativity and originality.</p>\n                    <p class=\"achievement-meta\">IEEE WIE Student Branch Affinity Group · Sabaragamuwa University of Sri Lanka</p>\n                </div>\n            </article>\n        </div>\n    ",
    "volunteering": "\n        <h2 class=\"section-title\">Volunteering &amp; <span>Leadership</span></h2>\n        <div class=\"volunteering-layout\">\n            <article class=\"volunteer-feature\">\n                <div class=\"volunteer-heading\">\n                    <h3>HOPE 2.0</h3>\n                    <span>2025</span>\n                </div>\n                <p class=\"volunteer-position\"><strong>Position:</strong> Knowledge Team · IEEE WIE Student Branch Affinity Group, Sabaragamuwa University of Sri Lanka</p>\n                <div class=\"volunteer-slideshow\" aria-label=\"HOPE 2.0 volunteer event photos\">\n                    <img class=\"volunteer-slide is-active\" src=\"image/optimized/hope-2.0-day-two.jpg\" alt=\"HOPE 2.0 Day Two learning activities\" loading=\"lazy\" decoding=\"async\">\n                    <img class=\"volunteer-slide\" src=\"image/optimized/hope-2.0-team.jpg\" alt=\"HOPE 2.0 knowledge team members\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                    <img class=\"volunteer-slide\" src=\"image/optimized/hope-2.0-mentoring.jpg\" alt=\"Volunteers helping students during HOPE 2.0\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                    <img class=\"volunteer-slide\" src=\"image/optimized/hope-2.0-workshop.jpg\" alt=\"A student working on a laptop during the HOPE 2.0 workshop\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                    <img class=\"volunteer-slide\" src=\"image/optimized/hope-2.0-microbit.jpg\" alt=\"Hands-on micro:bit activity at HOPE 2.0\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                    <button class=\"volunteer-slide-control volunteer-slide-prev\" type=\"button\" aria-label=\"Previous HOPE 2.0 photo\">\n                        <i class=\"fas fa-chevron-left\" aria-hidden=\"true\"></i>\n                    </button>\n                    <span class=\"volunteer-slide-count\" aria-live=\"polite\">1 / 5</span>\n                    <button class=\"volunteer-slide-control volunteer-slide-next\" type=\"button\" aria-label=\"Next HOPE 2.0 photo\">\n                        <i class=\"fas fa-chevron-right\" aria-hidden=\"true\"></i>\n                    </button>\n                </div>\n                <p class=\"volunteer-image-explanation\">As a volunteer with the HOPE 2.0 knowledge team, I supported students as they explored STEM through hands-on activities. They learned digital skills, asked questions, and tested their ideas. The experience strengthened my communication and teamwork while helping encourage young people’s curiosity and confidence.</p>\n                <p class=\"volunteer-caption\" aria-live=\"polite\">HOPE 2.0 · Day Two learning activities</p>\n            </article>\n            <div class=\"volunteer-roles\" aria-label=\"Other volunteer and leadership roles\">\n                <article class=\"volunteer-feature\">\n                    <div class=\"volunteer-heading\">\n                        <h3>සිප්මංසල</h3>\n                        <span>2026</span>\n                    </div>\n                    <p class=\"volunteer-position\"><strong>Position:</strong> Volunteer · Faculty of Computing, Sabaragamuwa University of Sri Lanka</p>\n                    <p class=\"volunteer-summary\"></p>\n                    <div class=\"volunteer-slideshow sipmansala-slideshow\" aria-label=\"සිප්මංසල volunteer photos\">\n                            <img class=\"volunteer-slide is-active\" src=\"image/optimized/1782474576078.jpg\" alt=\"The සිප්මංසල volunteer team\" loading=\"lazy\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/1782474576208.jpg\" alt=\"සිප්මංසල student bookmarks prepared for the program\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/1782474651913.jpg\" alt=\"සිප්මංසල learning materials at the student session\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/download.jpg\" alt=\"Teaching students during a සිප්මංසල session\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <button class=\"volunteer-slide-control volunteer-slide-prev\" type=\"button\" aria-label=\"Previous සිප්මංසල photo\"><i class=\"fas fa-chevron-left\" aria-hidden=\"true\"></i></button>\n                            <span class=\"volunteer-slide-count\" aria-live=\"polite\">1 / 4</span>\n                            <button class=\"volunteer-slide-control volunteer-slide-next\" type=\"button\" aria-label=\"Next සිප්මංසල photo\"><i class=\"fas fa-chevron-right\" aria-hidden=\"true\"></i></button>\n                    </div>\n                    <p class=\"volunteer-image-explanation\">Helped deliver English, Mathematics, Science, and IT sessions for G.C.E. O/L students, and shared IT and other career pathways to help them explore future opportunities. The experience strengthened my communication, presentation, and leadership skills while allowing me to support the community.</p>\n                    <p class=\"volunteer-caption sipmansala-caption\" aria-live=\"polite\">සිප්මංසල · Volunteer team</p>\n                </article>\n                <article class=\"volunteer-feature\">\n                    <div class=\"volunteer-heading\">\n                        <h3>VRUKSHA</h3>\n                        <span>2026</span>\n                    </div>\n                    <p class=\"volunteer-position\"><strong>Position:</strong> Co-Chair · Leo Club of Sabaragamuwa University of Sri Lanka</p>\n                    <p class=\"volunteer-summary\"></p>\n                    <div class=\"volunteer-slideshow vruksha-slideshow\" aria-label=\"VRUKSHA Season 7 photos\">\n                        <img class=\"volunteer-slide is-active\" src=\"image/optimized/ec37d084-f955-4b4f-be76-579bda38afe3.jpg\" alt=\"VRUKSHA Season 7 Leo Tree Plantation Challenge team celebration\" loading=\"lazy\" decoding=\"async\">\n                        <img class=\"volunteer-slide\" src=\"image/optimized/IMG_6371.jpg\" alt=\"VRUKSHA Season 7 organizing committee, including Co-Chair Himash Madushanka\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                        <img class=\"volunteer-slide\" src=\"image/optimized/IMG_6372.jpg\" alt=\"VRUKSHA Season 7 organizing committee team members\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                        <img class=\"volunteer-slide\" src=\"image/optimized/IMG_6721.jpg\" alt=\"Volunteers gathered after planting a tree\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                        <img class=\"volunteer-slide\" src=\"image/optimized/IMG_6722.jpg\" alt=\"A volunteer planting a tree during VRUKSHA\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                        <button class=\"volunteer-slide-control volunteer-slide-prev\" type=\"button\" aria-label=\"Previous VRUKSHA photo\"><i class=\"fas fa-chevron-left\" aria-hidden=\"true\"></i></button>\n                        <span class=\"volunteer-slide-count\" aria-live=\"polite\">1 / 5</span>\n                        <button class=\"volunteer-slide-control volunteer-slide-next\" type=\"button\" aria-label=\"Next VRUKSHA photo\"><i class=\"fas fa-chevron-right\" aria-hidden=\"true\"></i></button>\n                    </div>\n                    <p class=\"volunteer-image-explanation\">As Co-Chair, I helped coordinate volunteer teams, organize responsibilities, and communicate across the committee. I supported the group in resolving challenges and completing the project. The experience strengthened my leadership, project planning, collaboration, decision-making, and time-management skills while showing the value of teamwork in a community initiative.</p>\n                    <p class=\"volunteer-caption vruksha-caption\" aria-live=\"polite\">VRUKSHA · Season 7 team</p>\n                </article>\n                <article class=\"volunteer-feature\">\n                    <div class=\"volunteer-heading\">\n                        <h3>Career Guidance Program</h3>\n                        <span>2026</span>\n                    </div>\n                    <p class=\"volunteer-position\"><strong>Position:</strong> Co-Chair · Rotaract Club, Sabaragamuwa University of Sri Lanka</p>\n                    <p class=\"volunteer-summary\"></p>\n                    <div class=\"volunteer-slideshow career-guidance-slideshow\" aria-label=\"Career guidance program photos\">\n                            <img class=\"volunteer-slide is-active\" src=\"image/optimized/28d1506f-d850-4b35-aa81-453515a93eaf.jpg\" alt=\"Students attending the career guidance program\" loading=\"lazy\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/92aae81d-2979-4a3b-9222-897f8eb31b55.jpg\" alt=\"The student organizing team at the program\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/0813fc5d-caad-43ec-8d4b-c9393bdeb4ed.jpg\" alt=\"Himash speaking to students at the program\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/4199FD12-E608-4375-AABF-FFE736581CAC.jpg\" alt=\"Presenting a thank-you gift to a program speaker\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <img class=\"volunteer-slide\" src=\"image/optimized/e648e179-7e4c-440d-bbeb-254f505b5dcc.jpg\" alt=\"Career guidance program speaker and event poster\" loading=\"lazy\" fetchpriority=\"low\" decoding=\"async\">\n                            <button class=\"volunteer-slide-control volunteer-slide-prev\" type=\"button\" aria-label=\"Previous career guidance program photo\"><i class=\"fas fa-chevron-left\" aria-hidden=\"true\"></i></button>\n                            <span class=\"volunteer-slide-count\" aria-live=\"polite\">1 / 5</span>\n                            <button class=\"volunteer-slide-control volunteer-slide-next\" type=\"button\" aria-label=\"Next career guidance program photo\"><i class=\"fas fa-chevron-right\" aria-hidden=\"true\"></i></button>\n                    </div>\n                    <p class=\"volunteer-image-explanation\">As Co-Chair, I helped coordinate a career guidance program that connected students with learning opportunities. I supported planning and delivery alongside the organizing team. The experience strengthened my collaboration and event coordination skills while helping students explore possible career pathways.</p>\n                    <p class=\"volunteer-caption career-guidance-caption\" aria-live=\"polite\">Career guidance · Student session</p>\n                </article>\n            </div>\n        </div>\n    ",
